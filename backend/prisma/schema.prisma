generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        String  @id @default(uuid())
  firstName String? @default("")
  lastName  String? @default("")
  phone     String? @default("")
  name      String
  email     String  @unique
  password  String
  cartData  Json    @default("{}")
  addresses Json    @default("[]")
}

model Product {
  id              String  @id @default(uuid())
  name            String
  description     String  @db.Text
  price           Float
  image           Json
  category        String
  subCategory     String
  sizes           Json
  colors          Json    @default("[]")
  variants        Json    @default("[]")
  bestseller      Boolean   @default(false)
  newInStore      Boolean   @default(false)
  isSpecialOffer  Boolean   @default(false)
  offerTag        String?   @default("")
  offerEndDate    DateTime?
  discount        Float     @default(0)
  costPrice       Float     @default(0)
  stockQuantity     Int     @default(0)
  lowStockThreshold Int     @default(5)
  published         Boolean @default(true)
  date              BigInt
}

model Order {
  id              String  @id @default(uuid())
  userId          String
  items           Json
  amount          Float
  address         Json
  status          String  @default("Order Placed")
  paymentMethod   String
  payment         Boolean @default(false)
  date            BigInt
  loyaltyDiscount Float?  @default(0)
  rewardApplied   Json?
}

model Category {
  id   String @id @default(uuid())
  name String @unique
}

model SubCategory {
  id   String @id @default(uuid())
  name String @unique
}

model Color {
  id   String @id @default(uuid())
  name String @unique
}

model Review {
  id        String  @id @default(uuid())
  productId String
  userId    String
  userName  String
  userEmail String
  rating    Int
  title     String? @default("")
  comment   String  @db.Text
  likes     Json    @default("[]")
  dislikes  Json    @default("[]")
  verified  Boolean @default(true)
  date      BigInt
}

model ShippingConfig {
  id               String   @id @default("default")
  baseCity         String   @default("Kathmandu")
  sameCityFee      Float    @default(50)
  differentCityFee Float    @default(120)
  freeShippingMin  Float?   @default(0)
  updatedAt        DateTime @updatedAt
}

model CustomerLevel {
  id                String   @id @default(uuid())
  levelNumber       Int      @unique
  name              String
  badgeIcon         String   @default("🥉")
  color             String   @default("#CD7F32")
  minSpend          Float    @default(0)
  minOrders         Int      @default(0)
  rewardType        String   @default("CUSTOM")
  rewardValue       Float?   @default(0)
  rewardTitle       String   @default("Welcome Reward")
  rewardDescription String?  @db.Text
  rewardOrderLimit  Int      @default(3)
  freeShipping      Boolean  @default(false)
  discountAmount    Float    @default(0)
  giftAmount        Float    @default(0)
  giftDescription   String?  @default("")
  letterIncluded    Boolean  @default(false)
  customPerk        String?  @default("")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model CustomerLetterImage {
  id        String   @id @default(uuid())
  userId    String
  userEmail String?
  imageUrl  String
  title     String?  @default("Letter / Handwritten Note")
  notes     String?  @db.Text
  orderId   String?
  createdAt DateTime @default(now())
}

model SpecialOffer {
  id          String   @id @default(uuid())
  title       String
  subtitle    String?  @default("Exclusive festive deals and limited-time discounts")
  badgeText   String   @default("🎉 FESTIVE OFFER")
  bannerImage String?  @default("")
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean  @default(true)
  discount    Float?   @default(0)
  productIds  Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model StockLog {
  id           String   @id @default(uuid())
  productId    String
  productName  String
  variantLabel String?  @default("")
  previousQty  Int
  newQty       Int
  changeQty    Int
  reason       String
  note         String?  @db.Text
  orderId      String?
  source       String?  @default("admin")
  createdAt    DateTime @default(now())
}

model InboundShipment {
  id               String   @id @default(uuid())
  batchNumber      String   @unique
  carrier          String   @default("Local Freight")
  shipmentDate     DateTime
  totalFreightCost Float    @default(0)
  customsOrTaxes   Float    @default(0)
  notes            String?  @db.Text
  items            Json     @default("[]")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model MonthlyExpense {
  id                    String   @id @default(uuid())
  yearMonth             String   @unique
  marketingSpend        Float    @default(0)
  officeRent            Float    @default(0)
  utilities             Float    @default(0)
  salaries              Float    @default(0)
  softwareTools         Float    @default(0)
  packagingCostPerUnit  Float    @default(20)
  miscExpenses          Float    @default(0)
  projectedMonthlyUnits Int      @default(300)
  notes                 String?  @db.Text
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model Admin {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String   // bcrypt-hashed
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
